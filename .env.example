# Project Aether — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file!

# Pinata IPFS (get from https://pinata.cloud)
PINATA_JWT=your_pinata_jwt_here

# Base Sepolia RPC (get from https://alchemy.com)
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your_api_key

# Deployed contract address on Base Sepolia
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Host wallet (for registering files on-chain)
HOST_WALLET_ADDRESS=0xYourWalletAddress

# Host private key - NEVER SHARE THIS
# Generate a new wallet for this project: openssl rand -hex 32
HOST_PRIVATE_KEY=your_32_byte_private_key_hex

# Optional: Pinata Gateway (if using custom gateway)
# PINATA_GATEWAY=https://your-gateway.mypinata.cloud/ipfs/

# Optional: Custom contract ABI path
# CONTRACT_ABI_PATH=./contracts/abi/FileVerification.json